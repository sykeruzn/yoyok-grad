# --- Supabase ---
# Project Settings → API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
# The SERVICE ROLE key (not the anon/public one). Server-side only — never
# prefix this with NEXT_PUBLIC_ or it becomes visible to every visitor.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin dashboard ---
# Generate with: npm run hash -- "your-chosen-password"
ADMIN_PASSWORD_HASH=

# Any long random string — used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Core-friend reveal ---
# Your own name/nickname, used in the "you're part of ___'s core people" notice.
GIVER_NAME=Syke
# Core recipients see a locked notice instead of their puzzle until this
# moment. A bare date like "2026-09-25" is UTC midnight — add a time and
# offset (e.g. "2026-09-25T00:00:00-04:00") if you care about a specific
# timezone. Leave blank to never lock core friends.
CORE_UNLOCK_AT=2026-09-25
